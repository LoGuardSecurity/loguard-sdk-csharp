<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>LoGuardSecurity.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>LoGuard Security</Authors>
    <Company>LoGuard Security</Company>
    <Description>Official .NET SDK for LoGuard security monitoring.</Description>
    <PackageTags>security;monitoring;loguard;sdk;aspnetcore</PackageTags>
    <RepositoryUrl>https://github.com/LoGuardSecurity/loguard-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LoGuard.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ has its own .csproj; exclude it from this project's
         default recursive glob, or LoGuard.Sdk tries to compile the
         xunit test files as part of itself. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
